# Full URL to the backend API with no trailing slash
VITE_API_BASE_URL=your_backend_url_here

# Must exactly match API_KEY set on the server
VITE_API_KEY=your_api_key_here

# Database connection
DB_HOST=your_infinityfree_mysql_host
DB_PORT=3306
DB_NAME=if0_42008240_peerly_db
DB_USER=your_db_username
DB_PASS=your_db_password

ALLOWED_ORIGIN=https://yourusername.github.io

# Must exactly match VITE_API_KEY set on the frontend
API_KEY=your_api_key_here

# Find all three in the InfinityFree control panel under FTP Accounts
# FTP_SERVER          ->  ftpupload.net (example)
# FTP_USERNAME        ->  your InfinityFree FTP username
# FTP_PASSWORD        ->  your InfinityFree FTP password
# FTP_SERVER_DIR      ->  remote path (absolute path of directory)
