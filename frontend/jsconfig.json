{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["vite/client"],
		"moduleResolution": "bundler",
		"checkJs": true,
		"moduleDetection": "force",
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true,
		"rootDirs": ["./src"],
		"paths": {
			"@/*": ["./src/*"],
			"@pages/*": ["./src/pages/*"],
			"@components/*": ["./src/components/*"],
			"@services/*": ["./src/services/*"],
			"@styles/*": ["./src/styles/*"],
			"@types/*": ["./src/types/*"],
			"@utils/*": ["./src/utils/*"],
			"@assets/*": ["./src/assets/*"]
		}
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", ".idea", ".git", ".vscode", "dist"]
}
